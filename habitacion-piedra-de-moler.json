            {
              "id": "hab003g",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": [
                  {"text": "Servicio a la Habitación: Disponible en horario [xx:xx a xx:xx], desayuno, comida y cena (costo adicional).", "selected_icon": {"value": "fas fa-circle", "library": "fa-solid"}},
                  {"text": "Caja Fuerte: Guarda tus objetos de valor con total tranquilidad.", "selected_icon": {"value": "fas fa-circle", "library": "fa-solid"}},
                  {"text": "Secadora de Cabello: Disponible para tu cuidado personal.", "selected_icon": {"value": "fas fa-circle", "library": "fa-solid"}},
                  {"text": "Climatización: Ventilador de techo y aire acondicionado.", "selected_icon": {"value": "fas fa-circle", "library": "fa-solid"}},
